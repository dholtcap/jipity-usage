{
  "manifest_version": 3,
  "name": "ChatGPT Weekly Usage Pace",
  "version": "0.2.0",
  "description": "Tracks ChatGPT weekly usage, hourly pace, and projected usage on the Usage page and from a live browser popup.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Jipity Usage",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
